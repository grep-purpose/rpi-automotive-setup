#!/bin/sh

# MIRA: Statischer Hintergrund waehrend des Launcher-Starts

# MIRA_TRACE: timestamp before starting any applications
read mira_uptime mira_idle < /proc/uptime
/usr/bin/logger -t mira-start "MIRA_TRACE $mira_uptime AUTOSTART_ENTRY"

# Display-Konfiguration
/usr/bin/kanshi &

# Automotive Boot Launcher
read mira_uptime mira_idle < /proc/uptime
/usr/bin/logger -t mira-start "LAUNCHER_EXEC $mira_uptime"
exec /usr/bin/env \
HOME=/home/pi \
XDG_RUNTIME_DIR=/run/user/1000 \
QT_QPA_PLATFORM=wayland \
QT_WAYLAND_DISABLE_WINDOWDECORATION=1 \
python3 /home/pi/rpi-automotive-setup/launcher/boot_launcher.py

# AUTOMOTIVE_HIDE_CURSOR
(
    sleep 0.7
    wtype -M alt -M logo -P h -m alt -m logo
) &
