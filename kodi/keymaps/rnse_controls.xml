<?xml version='1.0' encoding='UTF-8'?>
<keymap>
  <global>
    <keyboard>
      <one>Down</one>
      <two>Up</two>
      <return>Select</return>
      <escape>Back</escape>
      <m>ActivateWindow(1150)</m>
      <up>RunScript(/home/pi/.kodi/userdata/rnse_zone_nav.py,up)</up>
      <down>RunScript(/home/pi/.kodi/userdata/rnse_zone_nav.py,down)</down>
      <left>Left</left>
      <right>Right</right>
      <prev_track>Left</prev_track>
      <next_track>Right</next_track>
      <f7>RunScript(/home/pi/.kodi/userdata/rnse_media_router.py,previous)</f7>
      <f8>RunScript(/home/pi/.kodi/userdata/rnse_media_router.py,next)</f8>
    </keyboard>
  </global>
  <Home>
    <keyboard>
      <up>RunScript(/home/pi/.kodi/userdata/rnse_zone_nav.py,up)</up>
      <down>RunScript(/home/pi/.kodi/userdata/rnse_zone_nav.py,down)</down>
      <left>PlayerControl(Previous)</left>
      <right>PlayerControl(Next)</right>
      <prev_track>PlayerControl(Previous)</prev_track>
      <next_track>PlayerControl(Next)</next_track>
      <one>Up</one>
      <two>Down</two>
    </keyboard>
  </Home>
  <FullScreenVideo>
    <keyboard>
      <return>PlayPause</return>
      <escape>Back</escape>
      <up>Info</up>
      <down>ActivateWindow(PVROSDChannels)</down>
      <left>StepBack</left>
      <right>StepForward</right>
      <prev_track>StepBack</prev_track>
      <next_track>StepForward</next_track>
    </keyboard>
  </FullScreenVideo>
  <FullScreenLiveTV>
    <keyboard>
      <return>PlayPause</return>
      <escape>Back</escape>
      <up>Info</up>
      <down>ActivateWindow(PVROSDChannels)</down>
      <left>ChannelDown</left>
      <right>ChannelUp</right>
      <prev_track>ChannelDown</prev_track>
      <next_track>ChannelUp</next_track>
      <f7>ChannelDown</f7>
      <f8>ChannelUp</f8>
    </keyboard>
  </FullScreenLiveTV>
  <VirtualKeyboard>
    <keyboard>
      <one>Left</one>
      <two>Right</two>
      <up>Up</up>
      <down>Down</down>
      <return>Select</return>
      <escape>PreviousMenu</escape>
      <f7>Delete</f7>
      <f8>Enter</f8>
      <prev_track>Delete</prev_track>
      <next_track>Enter</next_track>
      <left>Backspace</left>
      <left mod="longpress">Backspace</left>
    </keyboard>
  </VirtualKeyboard>
</keymap>