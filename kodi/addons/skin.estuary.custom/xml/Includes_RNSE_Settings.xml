         Checkbox / Chevron / weitere Bedienindikatoren.
         ========================================================= -->



    <!-- =========================================================
         RNSE SETTINGS ROW LAYOUT
         MASTER: Bluetooth

         Gemeinsame Architektur fuer alle Settings-Listen:
         - Label links
         - Label2 rechts
         - Checkbox/Chevron ganz rechts
         - identische Geometrie in WLAN und Bluetooth
         ========================================================= -->

    <include name="RNSE_SettingsRow_Normal">
        <control type="label">
            <left>35</left>
            <top>0</top>
            <width>720</width>
            <height>92</height>
            <font>font60</font>
            <textcolor>ffb7c0ca</textcolor>
            <aligny>center</aligny>
            <label>[B]$INFO[ListItem.Label][/B]</label>
        </control>
        <control type="label">
            <left>790</left>
            <top>0</top>
            <width>820</width>
            <height>92</height>
            <font>font60</font>
            <textcolor>ff8d99ae</textcolor>
            <align>right</align>
            <aligny>center</aligny>
            <label>[B]$INFO[ListItem.Label2][/B]</label>
        </control>
        <control type="image">
            <top>16</top>
            <width>60</width>
            <height>60</height>
            <aspectratio>keep</aspectratio>
            <texture>settings/chevron_normal.png</texture>
            <visible>String.IsEqual(ListItem.Property(RowType),submenu)</visible>
            <right>72</right>
        </control>
        <control type="image">
            <top>16</top>
            <width>60</width>
            <height>60</height>
            <aspectratio>keep</aspectratio>
            <texture>settings/checkbox_off_normal.png</texture>
            <visible>String.IsEqual(ListItem.Property(RowType),toggle) + !String.IsEqual(Window(Home).Property(RNSE.Bluetooth.EnabledState),on)</visible>
            <right>72</right>
        </control>
        <control type="image">
            <top>16</top>
            <width>60</width>
            <height>60</height>
            <aspectratio>keep</aspectratio>
            <texture>settings/checkbox_on_normal.png</texture>
            <visible>String.IsEqual(ListItem.Property(RowType),toggle) + String.IsEqual(Window(Home).Property(RNSE.Bluetooth.EnabledState),on)</visible>
            <right>72</right>
        </control>

    </include>

