<?xml version="1.0" encoding="UTF-8"?>
<addon
    id="service.rnse.metadata"
    name="RNS-E Metadata Service"
    version="1.0.0"
    provider-name="RNS-E Automotive">

    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>

    <extension
        point="xbmc.service"
        library="service.py"
        start="login"/>

    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">RNS-E radio metadata helper</summary>
        <description lang="en_GB">Provides radio.de station metadata to the Kodi skin.</description>
        <platform>all</platform>
    </extension>
</addon>
