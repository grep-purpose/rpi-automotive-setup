                <left>8</left><top>333</top>
                <width>326</width><height>46</height>
                <align>center</align><aligny>center</aligny>
                <font>font55</font>
                <textcolor>ffffffff</textcolor>
                <label>[B]Auto[/B]</label>
                <visible>String.IsEqual(ListItem.Label,Android Auto)</visible>
            </control>
        </control>
    </focusedlayout>
            <!-- =====================================================
                 APPS
                 Funktionspfade bewusst aus funktionierendem Stand
                 übernommen
                 ===================================================== -->
            <content>
                <item>
                    <label>TV</label>
                    <icon>home/mmi_icons_v1/tv.png</icon>
                    <onclick>ActivateWindow(TVChannels)</onclick>
                </item>
                <item>
                    <label>YouTube</label>
                    <icon>home/mmi_icons_v1/youtube.png</icon>
                    <onclick>ActivateWindow(Videos,plugin://plugin.video.youtube/special/recommendations?category_label=Recommendations,return)</onclick>
                </item>
                <item>
                    <label>Twitch</label>
                    <icon>home/mmi_icons_v1/twitch.png</icon>
                    <onclick>ActivateWindow(10025,"plugin://plugin.video.twitch/?content=live&amp;mode=followed",return)</onclick>
                </item>
                <item>
                    <label>Radio</label>
                    <icon>home/mmi_icons_v1/radio.png</icon>
                    <onclick>ActivateWindow(10502,"plugin://plugin.audio.radiode/?data=%7b%22name%22%3a%20%22Local%20stations%22%7d&amp;mode=get_local_stations",return)</onclick>
                </item>
                <item>
                    <label>Musik</label>
                    <icon>home/mmi_icons_v1/music.png</icon>
                    <onclick>ActivateWindow(11199)</onclick>
                </item>
                <item>
                    <label>Android Auto</label>
                    <icon>home/mmi_icons_v1/android_auto.png</icon>
                    <onclick>RunScript(/home/pi/.kodi/userdata/scripts/android_auto_toggle.py)</onclick>
                </item>
                <item>
                    <label>Wetter</label>
                    <icon>home/mmi_icons_v1/weather.png</icon>
                    <onclick>ActivateWindow(Weather)</onclick>
                </item>
                <item>
                    <label>Spiele</label>
                    <icon>home/mmi_icons_v1/games.png</icon>
                    <onclick>RunScript(script.audi.games)</onclick>
                </item>
            </content>
        </control>
        <!-- =========================================================
             NOW PLAYING
             große Automotive-Informationszone
             ========================================================= -->
        <control type="group">
            <left>30</left>
            <right>30</right>
            <bottom>175</bottom>
            <height>250</height>
            <visible>Player.HasMedia | !String.IsEmpty(Window(Home).Property(RNSE.RadioStation)) | String.IsEqual(Window(Home).Property(RNSE.Music.Status),playing)</visible>
            <!-- Schatten -->
            <control type="image">
                <left>5</left>
                <top>7</top>
                <width>100%</width>
                <height>230</height>
                <texture colordiffuse="99000000">colors/black.png</texture>
            </control>
            <!-- Hauptfläche -->
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>100%</width>
                <height>225</height>
                <texture colordiffuse="f20b1016">colors/white.png</texture>
            </control>
            <!-- obere Lichtkante -->
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>100%</width>
                <height>4</height>
                <texture colordiffuse="668d99ae">colors/white.png</texture>
            </control>
            <!-- Audi-Orange links -->
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>8</width>
                <height>225</height>
                <texture colordiffuse="ffff6b00">colors/white.png</texture>
            </control>
            <!-- Unified Music Artwork -->
            <control type="image">
                <left>22</left>
                <top>20</top>
                <width>195</width>
                <height>195</height>
                <aspectratio>keep</aspectratio>
                <texture>$INFO[Window(Home).Property(RNSE.Music.Artwork)]</texture>
                <visible>
                    String.IsEqual(Window(Home).Property(RNSE.Music.Status),playing)
                    + !String.IsEmpty(Window(Home).Property(RNSE.Music.Artwork))
                </visible>
            </control>
            <!-- Kodi Artwork Fallback -->
            <control type="image">
                <left>22</left>
                <top>20</top>
                <width>195</width>
                <height>195</height>
                <aspectratio>keep</aspectratio>
                <texture>$INFO[Player.Art(thumb)]</texture>
                <visible>
                    Player.HasMedia
                    + !String.IsEqual(Window(Home).Property(RNSE.Music.Status),playing)
                </visible>
            </control>
            <!-- Bluetooth ohne Cover -->
            <control type="image">
                <left>42</left>
                <top>40</top>
                <width>155</width>
                <height>155</height>
                <aspectratio>keep</aspectratio>
                <texture colordiffuse="ffc8cfd8">DefaultAlbumCover.png</texture>
                <visible>
                    String.IsEqual(Window(Home).Property(RNSE.Music.Status),playing)
                    + String.IsEmpty(Window(Home).Property(RNSE.Music.Artwork))
                </visible>
            </control>
            <!-- METADATEN MITTE -->
            <!-- =====================================================
                 NOW PLAYING METADATEN

                 Einheitliche Hierarchie:
                 oben  = Titel
                 unten = Interpret / Sender
                 ===================================================== -->
            <!-- RNSE MUSIC: Titel -->
            <control type="label">
                <left>255</left>
                <top>38</top>
                <width>980</width>
                <height>74</height>
                <font>font45</font>
                <textcolor>ffffffff</textcolor>
                <scroll>true</scroll>
                <label>[B]$INFO[Window(Home).Property(RNSE.Music.Title)][/B]</label>
                <visible>
                    String.IsEqual(Window(Home).Property(RNSE.Music.Status),playing)
                    + !String.IsEmpty(Window(Home).Property(RNSE.Music.Title))
                </visible>
            </control>
            <!-- RNSE MUSIC: Interpret -->
            <control type="label">
                <left>255</left>
                <top>116</top>
                <width>980</width>
                <height>74</height>
                <font>font45</font>
                <textcolor>ffff8a32</textcolor>
                <scroll>true</scroll>
                <label>[B]$INFO[Window(Home).Property(RNSE.Music.Artist)][/B]</label>
                <visible>
                    String.IsEqual(Window(Home).Property(RNSE.Music.Status),playing)
                    + !String.IsEmpty(Window(Home).Property(RNSE.Music.Artist))
                </visible>
            </control>
            <!-- KODI / RADIO: Titel -->
            <control type="label">
                <left>255</left>
                <top>38</top>
                <width>980</width>
                <height>74</height>
                <font>font45</font>
                <textcolor>ffffffff</textcolor>
                <scroll>true</scroll>
                <label>[B]$INFO[MusicPlayer.Title][/B]</label>
                <visible>
                    Player.HasMedia
                    + !String.IsEqual(Window(Home).Property(RNSE.Music.Status),playing)
                    + !String.IsEmpty(MusicPlayer.Title)
                </visible>
            </control>
            <!-- KODI / RADIO: Player.Title Fallback -->
            <control type="label">
                <left>255</left>
                <top>38</top>
                <width>980</width>
                <height>74</height>
                <font>font45</font>
                <textcolor>ffffffff</textcolor>
                <scroll>true</scroll>
                <label>[B]$INFO[Player.Title][/B]</label>
                <visible>
                    Player.HasMedia
                    + !String.IsEqual(Window(Home).Property(RNSE.Music.Status),playing)
                    + String.IsEmpty(MusicPlayer.Title)
                </visible>
            </control>
            <!-- KODI / RADIO: Interpret -->
            <control type="label">
                <left>255</left>
                <top>116</top>
                <width>980</width>
                <height>74</height>
                <font>font45</font>
                <textcolor>ffff8a32</textcolor>
                <scroll>true</scroll>
                <label>[B]$INFO[MusicPlayer.Artist][/B]</label>
                <visible>
                    Player.HasMedia
                    + !String.IsEqual(Window(Home).Property(RNSE.Music.Status),playing)
                    + !String.IsEmpty(MusicPlayer.Artist)
                </visible>
            </control>
            <!-- KODI / RADIO: Sender-Fallback -->
            <control type="label">
                <left>255</left>
                <top>116</top>
                <width>980</width>
                <height>74</height>
                <font>font45</font>
                <textcolor>ffff8a32</textcolor>
                <scroll>true</scroll>
                <label>[B]$INFO[MusicPlayer.ChannelName][/B]</label>
                <visible>
                    Player.HasMedia
                    + !String.IsEqual(Window(Home).Property(RNSE.Music.Status),playing)
                    + String.IsEmpty(MusicPlayer.Artist)
                    + !String.IsEmpty(MusicPlayer.ChannelName)
                </visible>
            </control>
            <!-- RECHTE STATUSZONE -->
            <!-- vertikale Trennung -->
            <control type="image">
                <left>1325</left>
                <top>24</top>
                <width>3</width>
                <height>178</height>
                <texture colordiffuse="668d99ae">colors/white.png</texture>
            </control>
            <!-- =====================================================
                 RECHTE STATUSZONE
                 Radio: Sender / Provider / Live
                 Andere Medien: bisherige Quellenanzeige
                 ===================================================== -->
            <!-- Radio: Überschrift -->
            <control type="label">
                <left>1365</left>
                <top>30</top>
                <width>400</width>
                <height>45</height>
                <font>font30_title</font>
                <textcolor>ff9da6b2</textcolor>
                <visible>!String.IsEmpty(Window(Home).Property(RNSE.RadioStation)) + !String.IsEqual(Window(Home).Property(RNSE.Music.Status),playing)</visible>
                <label>SENDER</label>
            </control>
            <!-- Andere Medien: Überschrift -->
            <control type="label">
                <left>1365</left>
                <top>30</top>
                <width>400</width>
                <height>45</height>
                <font>font30_title</font>
                <textcolor>ff9da6b2</textcolor>
                <visible>String.IsEqual(Window(Home).Property(RNSE.Music.Status),playing) | String.IsEmpty(Window(Home).Property(RNSE.RadioStation))</visible>
                <label>QUELLE</label>
            </control>
            <!-- Radio: echter Sendername aus Metadata Service -->
            <control type="label">
                <left>1365</left>
                <top>72</top>
                <width>430</width>
                <height>65</height>
                <font>font45</font>
                <textcolor>ffffffff</textcolor>
                <visible>!String.IsEmpty(Window(Home).Property(RNSE.RadioStation)) + !String.IsEqual(Window(Home).Property(RNSE.Music.Status),playing)</visible>
                <label>[B]$INFO[Window(Home).Property(RNSE.RadioStation)][/B]</label>
            </control>
            <!-- Radio: Provider -->
            <control type="label">
                <left>1365</left>
                <top>145</top>
                <width>190</width>
                <height>50</height>
                <font>font30_title</font>
                <textcolor>ffd5dae0</textcolor>
                <visible>!String.IsEmpty(Window(Home).Property(RNSE.RadioStation)) + !String.IsEqual(Window(Home).Property(RNSE.Music.Status),playing)</visible>
                <label>RADIO.DE</label>
            </control>
            <!-- Radio: Trenner -->
            <control type="label">
                <left>1535</left>
                <top>145</top>
                <width>35</width>
                <height>50</height>
                <font>font30_title</font>
                <textcolor>ff7f8790</textcolor>
                <visible>!String.IsEmpty(Window(Home).Property(RNSE.RadioStation)) + !String.IsEqual(Window(Home).Property(RNSE.Music.Status),playing)</visible>
                <label>·</label>
            </control>
            <!-- Radio: Live-Status -->
            <control type="label">
                <left>1570</left>
                <top>145</top>
                <width>150</width>
                <height>50</height>
                <font>font30_title</font>
                <textcolor>ffff8a32</textcolor>
                <visible>!String.IsEmpty(Window(Home).Property(RNSE.RadioStation)) + !String.IsEqual(Window(Home).Property(RNSE.Music.Status),playing)</visible>
                <label>[B]LIVE[/B]</label>
            </control>
            <!-- Andere Medien: echter ChannelName, falls vorhanden -->
            <control type="label">
                <left>1365</left>
                <top>72</top>
                <width>430</width>
                <height>65</height>
                <font>font45</font>
                <textcolor>ffffffff</textcolor>
                <visible>String.IsEmpty(Window(Home).Property(RNSE.RadioStation)) + !String.IsEmpty(MusicPlayer.ChannelName)</visible>
                <label>[B]$INFO[MusicPlayer.ChannelName][/B]</label>
            </control>
            <!-- Radio.de Fallback, falls Metadata Service einmal nichts liefert -->
            <control type="label">
                <left>1365</left>
                <top>72</top>
                <width>430</width>
                <height>65</height>
                <font>font45</font>
                <textcolor>ffffffff</textcolor>
                <visible>String.IsEmpty(Window(Home).Property(RNSE.RadioStation)) + String.IsEmpty(MusicPlayer.ChannelName) + String.Contains(Player.FilenameAndPath,plugin.audio.radiode)</visible>
                <label>[B]RADIO.DE[/B]</label>
            </control>
            <!-- Unified Music Quelle -->
            <control type="label">
                <left>1365</left>
                <top>72</top>
                <width>430</width>
                <height>65</height>
                <font>font45</font>
                <textcolor>ffffffff</textcolor>
                <scroll>true</scroll>
                <visible>
                    String.IsEqual(Window(Home).Property(RNSE.Music.Status),playing)
                </visible>
                <label>[B]$INFO[Window(Home).Property(RNSE.Music.SourceLabel)][/B]</label>
            </control>
            <!-- Generischer Medien-Fallback -->
            <control type="label">
                <left>1365</left>
                <top>72</top>
                <width>430</width>
                <height>65</height>
                <font>font45</font>
                <textcolor>ffffffff</textcolor>
                <visible>
                    !String.IsEqual(Window(Home).Property(RNSE.Music.Connected),true)
                    + String.IsEmpty(Window(Home).Property(RNSE.RadioStation))
                    + String.IsEmpty(MusicPlayer.ChannelName)
                    + !String.Contains(Player.FilenameAndPath,plugin.audio.radiode)
                </visible>
                <label>[B]MEDIA[/B]</label>
            </control>
            <!-- Andere Medien: LIVE bei Streams ohne Dauer -->
            <control type="label">
                <left>1365</left>
                <top>145</top>
                <width>430</width>
                <height>50</height>
                <font>font36_title</font>
                <textcolor>ffff8a32</textcolor>
                <visible>!String.IsEqual(Window(Home).Property(RNSE.Music.Connected),true) + String.IsEmpty(Window(Home).Property(RNSE.RadioStation)) + String.IsEmpty(Player.Duration)</visible>
                <label>[B]LIVE[/B]</label>
            </control>
            <!-- Unified Music Laufzeit -->
            <control type="label">
                <left>1365</left>
                <top>145</top>
                <width>430</width>
                <height>50</height>
                <font>font30_title</font>
                <textcolor>ffd5dae0</textcolor>
                <visible>
                    String.IsEqual(Window(Home).Property(RNSE.Music.Connected),true)
                </visible>
                <label>$INFO[Window(Home).Property(RNSE.Music.PositionText)] / $INFO[Window(Home).Property(RNSE.Music.DurationText)]</label>
            </control>
            <!-- Andere Medien: Laufzeit -->
            <control type="label">
                <left>1365</left>
                <top>145</top>
                <width>430</width>
                <height>50</height>
                <font>font30_title</font>
                <textcolor>ffd5dae0</textcolor>
                <visible>!String.IsEqual(Window(Home).Property(RNSE.Music.Connected),true) + String.IsEmpty(Window(Home).Property(RNSE.RadioStation)) + !String.IsEmpty(Player.Duration)</visible>
                <label>$INFO[Player.Time]  /  $INFO[Player.Duration]</label>
            </control>
            <!-- untere Akzentlinie -->
            <control type="image">
                <left>255</left>
                <top>205</top>
                <width>930</width>
                <height>3</height>
                <texture colordiffuse="338d99ae">colors/white.png</texture>
            </control>
        </control>
        <!-- =========================================================
             FOOTER
             ========================================================= -->
        <include content="RNSE_GlobalFooter">
            <param name="footer_left_id" value="9100" />
            <param name="footer_right_id" value="9101" />
        </include>
    </controls>
</window>