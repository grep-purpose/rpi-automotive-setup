<?xml version="1.0" encoding="UTF-8"?>
<addon id="service.mira.usbstatus"
       name="Mira USB Status Monitor"
       version="1.0.0"
       provider-name="Mira">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.service"
               library="service.py"
               start="startup"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="de_DE">USB-Gerätenamen automatisch aktualisieren</summary>
        <description lang="de_DE">Synchronisiert die USB-Geräteanzeige mit dem zentralen Mira-Status.</description>
        <platform>all</platform>
    </extension>
</addon>
