<?xml version='1.0' encoding='UTF-8'?>
<window id="1163">

    <defaultcontrol always="true">9680</defaultcontrol>

    <onload>RunScript(/home/pi/.kodi/userdata/scripts/bluetooth_manager.py,detail_refresh)</onload>

    <controls>

        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="ff05070a">colors/black.png</texture>
        </control>

        <control type="group">
            <left>30</left>
            <right>30</right>
            <top>18</top>
            <height>105</height>

            <control type="label">
                <left>540</left>
                <top>0</top>
                <width>780</width>
                <height>100</height>
                <align>center</align>
                <aligny>center</aligny>
                <font>font60</font>
                <textcolor>ffd90429</textcolor>
                <label>[B]$INFO[Window(Home).Property(RNSE.Bluetooth.Detail.Name)][/B]</label>
            </control>
        </control>

        <control type="list" id="9680">

            <orientation>vertical</orientation>

            <onup>Control.Move(9680,-1)</onup>
            <ondown>Control.Move(9680,1)</ondown>
            <onleft>Control.Move(9680,-1)</onleft>
            <onright>Control.Move(9680,1)</onright>

            <itemlayout width="1760" height="92">

                <include>RNSE_SettingsRow_Normal</include>

                <control type="image">
                    <top>16</top>
                    <right>72</right>
                    <width>60</width>
                    <height>60</height>
                    <aspectratio>keep</aspectratio>
                    <texture>settings/checkbox_off_normal.png</texture>
                    <visible>
                        String.IsEqual(ListItem.Property(RowType),autostart)
                        +
                        !String.IsEqual(Window(Home).Property(RNSE.Bluetooth.Detail.Autostart),true)
                    </visible>
                </control>

                <control type="image">
                    <top>16</top>
                    <right>72</right>
                    <width>60</width>
                    <height>60</height>
                    <aspectratio>keep</aspectratio>
                    <texture>settings/checkbox_on_normal.png</texture>
                    <visible>
                        String.IsEqual(ListItem.Property(RowType),autostart)
                        +
                        String.IsEqual(Window(Home).Property(RNSE.Bluetooth.Detail.Autostart),true)
                    </visible>
                </control>

            </itemlayout>

            <focusedlayout width="1760" height="92">

                <include>RNSE_SettingsRow_Focused</include>

                <control type="image">
                    <top>16</top>
                    <right>72</right>
                    <width>60</width>
                    <height>60</height>
                    <aspectratio>keep</aspectratio>
                    <texture>settings/checkbox_off_focus.png</texture>
                    <visible>
                        String.IsEqual(ListItem.Property(RowType),autostart)
                        +
                        !String.IsEqual(Window(Home).Property(RNSE.Bluetooth.Detail.Autostart),true)
                    </visible>
                </control>

                <control type="image">
                    <top>16</top>
                    <right>72</right>
                    <width>60</width>
                    <height>60</height>
                    <aspectratio>keep</aspectratio>
                    <texture>settings/checkbox_on_focus.png</texture>
                    <visible>
                        String.IsEqual(ListItem.Property(RowType),autostart)
                        +
                        String.IsEqual(Window(Home).Property(RNSE.Bluetooth.Detail.Autostart),true)
                    </visible>
                </control>

            </focusedlayout>

            <content>

                <item>
                    <label>Autostart berechtigt</label>
                    <property name="RowType">autostart</property>
                    <onclick>RunScript(/home/pi/.kodi/userdata/scripts/bluetooth_manager.py,detail_autostart)</onclick>
                </item>

                <item>
                    <label>$INFO[Window(Home).Property(RNSE.Bluetooth.Detail.ConnectionAction)]</label>
                    <property name="RowType">action</property>
                    <onclick>RunScript(/home/pi/.kodi/userdata/scripts/bluetooth_manager.py,detail_connection)</onclick>
                </item>

                <item>
                    <label>Gerät vergessen</label>
                    <property name="RowType">action</property>
                    <onclick>RunScript(/home/pi/.kodi/userdata/scripts/bluetooth_manager.py,detail_forget)</onclick>
                </item>

            </content>

            <pagecontrol>9681</pagecontrol>

            <left>60</left>
            <top>104</top>
            <bottom>158</bottom>
            <width>1760</width>

        </control>

        <control type="scrollbar" id="9681">

            <visible>Container(9680).HasNext | Container(9680).HasPrevious</visible>

            <texturesliderbackground colordiffuse="443f4650">colors/white.png</texturesliderbackground>
            <texturesliderbar colordiffuse="ff8d99ae">colors/white.png</texturesliderbar>
            <texturesliderbarfocus colordiffuse="ffff6b00">colors/white.png</texturesliderbarfocus>

            <textureslidernib />
            <textureslidernibfocus />

            <left>1840</left>
            <top>104</top>
            <bottom>158</bottom>
            <width>8</width>

            <orientation>vertical</orientation>
            <showonepage>false</showonepage>

        </control>

        <include>RNSE_SettingsFooter</include>

    </controls>

</window>
