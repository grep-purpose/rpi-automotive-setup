[Unit]
Description=Raspberry Pi Automotive RNS-E Input Watchdog
After=can_handler.service can_keyboard_control.service
Wants=can_handler.service can_keyboard_control.service

[Service]
Type=simple
User=root
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/pi/rpi-automotive-setup/scripts/input_watchdog.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
