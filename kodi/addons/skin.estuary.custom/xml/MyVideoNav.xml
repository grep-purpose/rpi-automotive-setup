<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<backgroundcolor>background</backgroundcolor>
	<views>50</views>
	<menucontrol>9000</menucontrol>
	<controls>
		<!-- 1. Background -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>100%</width>
			<height>100%</height>
			<texture>colors/black.png</texture>
		</control>

		<!-- 2. Großer OEM Audi Top-Header -->
		<control type="group">
			<top>15</top>
			<left>40</left>
			<right>40</right>
			<height>85</height>

			<!-- Oben Links: Suche (ID 9001) -->
			<control type="button" id="9001">
				<left>10</left>
				<top>5</top>
				<width>260</width>
				<height>65</height>
				<font>font45</font>
				<label>[B]Suche[/B]</label>
				<align>left</align>
				<textoffsetx>10</textoffsetx>
				<textcolor>fff0f2f5</textcolor>
				<focusedcolor>ffff8800</focusedcolor>
				<texturefocus border="0">-</texturefocus>
				<texturenofocus border="0">-</texturenofocus>
				<onup>9003</onup>
				<ondown>50</ondown>
				<onclick>Skin.SetString(SearchQuery)</onclick>
			</control>

			<!-- Trennlinie Links (top 75) -->
			<control type="image">
				<left>10</left>
				<top>75</top>
				<width>300</width>
				<height>4</height>
				<texture colordiffuse="88ffffff">colors/white.png</texture>
			</control>

			<!-- Zentrierter Audi MMI Titel (Audi-Rot) -->
			<control type="label">
				<left>0</left>
				<right>0</right>
				<top>10</top>
				<height>75</height>
				<align>center</align>
				<font>font45</font>
				<textcolor>ffd90429</textcolor>
				<label>[B]$INFO[Container.FolderName][/B]</label>
			</control>

			<!-- Oben Rechts: Aktualisieren / Reload (ID 9003 - Anschlag ganz oben) -->
			<control type="button" id="9003">
				<right>10</right>
				<top>5</top>
				<width>280</width>
				<height>65</height>
				<font>font45</font>
				<label>[B]Neu laden[/B]</label>
				<align>right</align>
				<textoffsetx>10</textoffsetx>
				<textcolor>fff0f2f5</textcolor>
				<focusedcolor>ffff8800</focusedcolor>
				<texturefocus border="0">-</texturefocus>
				<texturenofocus border="0">-</texturenofocus>
				<onup>noop</onup>
				<ondown>9001</ondown>
				<onclick>Container.Refresh</onclick>
			</control>

			<!-- Trennlinie Rechts (top 75) -->
			<control type="image">
				<right>10</right>
				<top>75</top>
				<width>300</width>
				<height>4</height>
				<texture colordiffuse="88ffffff">colors/white.png</texture>
			</control>
		</control>

		<!-- 3. RNS-E Hero List -->
		<control type="fixedlist" id="50">
			<left>40</left>
			<top>105</top>
			<bottom>135</bottom>
			<width>1840</width>
			<onup>9001</onup>
			<ondown>9002</ondown>
			<onleft>50</onleft>
			<onright>50</onright>
			<viewtype label="Kacheln">list</viewtype>
			<orientation>vertical</orientation>
			<focusposition>0</focusposition>
			<movement>1</movement>
			<scrolltime tween="sine" easing="out">130</scrolltime>
			<hideparentitems>true</hideparentitems>

			<itemlayout width="1840" height="420">
				<control type="image">
					<left>10</left>
					<top>15</top>
					<width>660</width>
					<height>371</height>
					<texture background="true" fallback="DefaultVideo.png">$INFO[ListItem.Art(thumb)]</texture>
					<aspectratio align="center" aligny="center">scale</aspectratio>
				</control>
				<control type="label">
					<left>700</left>
					<top>25</top>
					<width>1120</width>
					<height>170</height>
					<font>font45</font>
					<textcolor>grey</textcolor>
					<wrapmultiline>true</wrapmultiline>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<left>700</left>
					<top>230</top>
					<width>1120</width>
					<height>60</height>
					<font>font30_title</font>
					<textcolor>darkgrey</textcolor>
					<label>$INFO[ListItem.Duration,[B],[/B]  •  ]$INFO[ListItem.Date]</label>
				</control>
			</itemlayout>

			<focusedlayout width="1840" height="420">
				<!-- Fokus-Rahmen um Thumbnail -->
				<control type="image">
					<left>4</left>
					<top>9</top>
					<width>672</width>
					<height>383</height>
					<texture border="6">colors/white.png</texture>
					<colordiffuse>ffff8800</colordiffuse>
				</control>
				<control type="image">
					<left>10</left>
					<top>15</top>
					<width>660</width>
					<height>371</height>
					<texture background="true" fallback="DefaultVideo.png">$INFO[ListItem.Art(thumb)]</texture>
					<aspectratio align="center" aligny="center">scale</aspectratio>
				</control>
				<control type="label">
					<left>700</left>
					<top>25</top>
					<width>1120</width>
					<height>170</height>
					<font>font45</font>
					<textcolor>white</textcolor>
					<scroll>true</scroll>
					<wrapmultiline>true</wrapmultiline>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<left>700</left>
					<top>230</top>
					<width>1120</width>
					<height>60</height>
					<font>font30_title</font>
					<textcolor>ffff8800</textcolor>
					<label>$INFO[ListItem.Duration,[B],[/B]  •  ]$INFO[ListItem.Date]</label>
				</control>
			</focusedlayout>
		</control>

		<!-- 4. RNS-E Status-Footer mit symmetrischen Shortcuts -->
		<control type="group">
			<bottom>15</bottom>
			<left>40</left>
			<right>40</right>
			<height>120</height>

			<!-- Weiße Trennlinie -->
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>100%</width>
				<height>6</height>
				<texture colordiffuse="99ffffff">colors/white.png</texture>
			</control>

			<!-- Unten Links: Einstellungen (ID 9002) -->
			<control type="button" id="9002">
				<left>20</left>
				<top>20</top>
				<width>380</width>
				<height>75</height>
				<font>font45</font>
				<label>[B]Einstellungen[/B]</label>
				<align>left</align>
				<textcolor>fff0f2f5</textcolor>
				<focusedcolor>ffff8800</focusedcolor>
				<texturefocus border="0">-</texturefocus>
				<texturenofocus border="0">-</texturenofocus>
				<onup>50</onup>
				<ondown>9004</ondown>
				<onclick>ActivateWindow(Settings)</onclick>
			</control>

			<!-- Unten Mitte: Wetter & Digitaluhr -->
			<control type="group">
				<left>0</left>
				<right>0</right>
				<top>25</top>
				<height>75</height>

				<control type="group">
					<left>700</left>
					<top>0</top>
					<width>520</width>
					<height>75</height>

					<!-- Wetter Icon -->
					<control type="image">
						<left>0</left>
						<top>8</top>
						<width>65</width>
						<height>65</height>
						<aspectratio>keep</aspectratio>
						<texture>$INFO[Weather.ConditionsIcon]</texture>
					</control>

					<!-- Temperatur -->
					<control type="label">
						<left>80</left>
						<top>0</top>
						<width>170</width>
						<height>75</height>
						<font>font45</font>
						<textcolor>fff0f2f5</textcolor>
						<label>[B]$INFO[Weather.Temperature][/B]</label>
					</control>

					<!-- Digitaluhr -->
					<control type="label">
						<left>265</left>
						<top>0</top>
						<width>255</width>
						<height>75</height>
						<font>font45</font>
						<textcolor>fff0f2f5</textcolor>
						<label>[B]$INFO[System.Time(hh:mm)][/B]</label>
					</control>
				</control>
			</control>

			<!-- Unten Rechts: Home (ID 9004 - Anschlag ganz unten) -->
			<control type="button" id="9004">
				<right>20</right>
				<top>20</top>
				<width>320</width>
				<height>75</height>
				<font>font45</font>
				<label>[B]Hauptmenü[/B]</label>
				<align>right</align>
				<textcolor>fff0f2f5</textcolor>
				<focusedcolor>ffff8800</focusedcolor>
				<texturefocus border="0">-</texturefocus>
				<texturenofocus border="0">-</texturenofocus>
				<onup>9002</onup>
				<ondown>noop</ondown>
				<onclick>ActivateWindow(Home)</onclick>
			</control>
		</control>
	</controls>
</window>
