#!/usr/bin/env bash
set -euo pipefail

# Mira Screenshot Service
SCREENSHOT_DIR="/home/pi/Pictures/Mira"
RUNTIME_DIR="/run/user/$(id -u)"
OUTPUT="HDMI-A-1"

mkdir -p "$SCREENSHOT_DIR"

# Aktiven Wayland-Socket ermitteln
WAYLAND_SOCKET=""

for socket in "$RUNTIME_DIR"/wayland-*; do
    if [ -S "$socket" ]; then
        WAYLAND_SOCKET="$(basename "$socket")"
        break
    fi
done

if [ -z "$WAYLAND_SOCKET" ]; then
    echo "Mira: Kein Wayland-Socket gefunden."
    exit 1
fi

# Eindeutigen Dateinamen erstellen
TIMESTAMP="$(date '+%Y-%m-%d_%H-%M-%S-%N')"
FILE="$SCREENSHOT_DIR/mira-$TIMESTAMP.png"

# Screenshot aufnehmen
if XDG_RUNTIME_DIR="$RUNTIME_DIR" \
   WAYLAND_DISPLAY="$WAYLAND_SOCKET" \
   grim -o "$OUTPUT" "$FILE"; then

    echo "Mira: Screenshot gespeichert!"
    echo "$FILE"
else
    rm -f "$FILE"
    echo "Mira: Screenshot fehlgeschlagen."
    exit 1
fi
