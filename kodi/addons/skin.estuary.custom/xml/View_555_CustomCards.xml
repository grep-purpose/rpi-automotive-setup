<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<include name="View_555_CustomCards">
		<control type="panel" id="555">
			<left>50</left>
			<top>110</top>
			<width>1820</width>
			<height>920</height>
			<onup>9001</onup>
			<ondown>noop</ondown>
			<onleft>555</onleft>
			<onright>555</onright>
			<viewtype label="Kacheln">panel</viewtype>
			<orientation>horizontal</orientation>
			<scrolltime tween="sine" easing="out">180</scrolltime>
			<visible>String.StartsWith(Container.PluginName,plugin.video.twitch) | String.StartsWith(Container.PluginName,plugin.video.youtube) | Container.Content(videos)</visible>

			<itemlayout width="340" height="230">
				<control type="image">
					<left>10</left>
					<top>10</top>
					<width>320</width>
					<height>180</height>
					<texture background="true" fallback="DefaultVideo.png">$INFO[ListItem.Art(thumb)]</texture>
					<aspectratio align="center" aligny="center">scale</aspectratio>
				</control>
				<control type="label">
					<left>15</left>
					<top>195</top>
					<width>310</width>
					<height>25</height>
					<font>font12</font>
					<textcolor>grey</textcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</itemlayout>

			<focusedlayout width="340" height="230">
				<control type="image">
					<left>6</left>
					<top>6</top>
					<width>328</width>
					<height>188</height>
					<texture border="4">colors/white.png</texture>
					<colordiffuse>button_focus</colordiffuse>
				</control>
				<control type="image">
					<left>10</left>
					<top>10</top>
					<width>320</width>
					<height>180</height>
					<texture background="true" fallback="DefaultVideo.png">$INFO[ListItem.Art(thumb)]</texture>
					<aspectratio align="center" aligny="center">scale</aspectratio>
				</control>
				<control type="label">
					<left>15</left>
					<top>195</top>
					<width>310</width>
					<height>25</height>
					<font>font12_bold</font>
					<textcolor>white</textcolor>
					<scroll>true</scroll>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</focusedlayout>
		</control>
	</include>
</includes>
