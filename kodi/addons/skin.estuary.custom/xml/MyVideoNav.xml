<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<backgroundcolor>background</backgroundcolor>
	<views>50</views>
	<menucontrol>9000</menucontrol>
	<controls>
		<!-- 1. Background -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>100%</width>
			<height>100%</height>
			<texture>colors/black.png</texture>
		</control>

		<!-- 2. Großer OEM Audi Top-Header -->
		<control type="group">
                        <top>18</top>
                        <left>30</left>
                        <right>30</right>
                        <height>105</height>

                        <!-- Linke Header-Linie -->
                        <control type="image">
                                <left>0</left>
                                <top>82</top>
                                <width>525</width>
                                <height>3</height>
                                <texture colordiffuse="99ffffff">colors/white.png</texture>
                        </control>

                        <!-- Linker Softkey: Suche -->
                        <control type="button" id="9001">
                                <left>15</left>
                                <top>0</top>
                                <width>330</width>
                                <height>82</height>
                                <font>font45</font>
                                <label>[B]Suche[/B]</label>
                                <align>left</align>
                                <aligny>center</aligny>
                                <textcolor>fff0f2f5</textcolor>
                                <focusedcolor>ffff8800</focusedcolor>
                                <texturefocus>-</texturefocus>
                                <texturenofocus>-</texturenofocus>
                                <onup>9003</onup>
                                <ondown>9003</ondown>
                                <onclick>Skin.SetString(SearchQuery)</onclick>
                        </control>

                        <!-- Mittiger App-/Ordnername -->
                        <control type="label">
                                <left>540</left>
                                <top>0</top>
                                <width>780</width>
                                <height>100</height>
                                <align>center</align>
                                <aligny>center</aligny>
                                <font>font60</font>
                                <textcolor>ffd90429</textcolor>
                                <label>[B]$INFO[Container.FolderName][/B]</label>
                        </control>

                        <!-- Rechter Softkey: Neu laden -->
                        <control type="button" id="9003">
                                <right>15</right>
                                <top>0</top>
                                <width>330</width>
                                <height>82</height>
                                <font>font45</font>
                                <label>[B]Neu laden[/B]</label>
                                <align>right</align>
                                <aligny>center</aligny>
                                <textcolor>fff0f2f5</textcolor>
                                <focusedcolor>ffff8800</focusedcolor>
                                <texturefocus>-</texturefocus>
                                <texturenofocus>-</texturenofocus>
                                <onup>9001</onup>
                                <ondown>9001</ondown>
                                <onclick>Container.Refresh</onclick>
                        </control>

                        <!-- Rechte Header-Linie -->
                        <control type="image">
                                <right>0</right>
                                <top>82</top>
                                <width>525</width>
                                <height>3</height>
                                <texture colordiffuse="99ffffff">colors/white.png</texture>
                        </control>

                </control>

		<!-- 3. RNS-E Hero List -->
		<control type="fixedlist" id="50">
			<left>40</left>
			<top>135</top>
			<bottom>135</bottom>
			<width>1840</width>
			<onup>50</onup>
			<ondown>50</ondown>
			<onleft>50</onleft>
			<onright>50</onright>
			<viewtype label="Kacheln">list</viewtype>
			<orientation>vertical</orientation>
			<focusposition>0</focusposition>
			<movement>1</movement>
			<scrolltime tween="sine" easing="out">130</scrolltime>
			<hideparentitems>true</hideparentitems>

			<itemlayout width="1840" height="420">
				<control type="image">
					<left>10</left>
					<top>15</top>
					<width>660</width>
					<height>371</height>
					<texture background="true" fallback="DefaultVideo.png">$INFO[ListItem.Art(thumb)]</texture>
					<aspectratio align="center" aligny="center">scale</aspectratio>
				</control>
				<control type="label">
					<left>700</left>
					<top>25</top>
					<width>1120</width>
					<height>170</height>
					<font>font45</font>
					<textcolor>grey</textcolor>
					<wrapmultiline>true</wrapmultiline>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<left>700</left>
					<top>230</top>
					<width>1120</width>
					<height>60</height>
					<font>font30_title</font>
					<textcolor>darkgrey</textcolor>
					<label>$INFO[ListItem.Duration,[B],[/B]  •  ]$INFO[ListItem.Date]</label>
				</control>
			</itemlayout>

			<focusedlayout width="1840" height="420">
				<!-- Fokus-Rahmen um Thumbnail -->
				<control type="image">
					<left>4</left>
					<top>9</top>
					<width>672</width>
					<height>383</height>
					<texture border="6">colors/white.png</texture>
					<colordiffuse>ffff8800</colordiffuse>
				</control>
				<control type="image">
					<left>10</left>
					<top>15</top>
					<width>660</width>
					<height>371</height>
					<texture background="true" fallback="DefaultVideo.png">$INFO[ListItem.Art(thumb)]</texture>
					<aspectratio align="center" aligny="center">scale</aspectratio>
				</control>
				<control type="label">
					<left>700</left>
					<top>25</top>
					<width>1120</width>
					<height>170</height>
					<font>font45</font>
					<textcolor>white</textcolor>
					<scroll>true</scroll>
					<wrapmultiline>true</wrapmultiline>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<left>700</left>
					<top>230</top>
					<width>1120</width>
					<height>60</height>
					<font>font30_title</font>
					<textcolor>ffff8800</textcolor>
					<label>$INFO[ListItem.Duration,[B],[/B]  •  ]$INFO[ListItem.Date]</label>
				</control>
			</focusedlayout>
		</control>

		<!-- 4. RNS-E Status-Footer mit symmetrischen Shortcuts -->
		<control type="group">
                        <bottom>18</bottom>
                        <left>30</left>
                        <right>30</right>
                        <height>124</height>

                        <!-- obere MMI-Linie -->
                        <control type="image">
                                <left>0</left>
                                <top>0</top>
                                <width>100%</width>
                                <height>5</height>
                                <texture colordiffuse="aaffffff">colors/white.png</texture>
                        </control>

                        <!-- Einstellungen links -->
                        <control type="button" id="9002">
                                <left>15</left>
                                <top>20</top>
                                <width>500</width>
                                <height>82</height>
                                <font>font45</font>
                                <label>[B]Einstellungen[/B]</label>
                                <align>left</align>
                                <textoffsetx>0</textoffsetx>
                                <aligny>center</aligny>
                                <textcolor>fff0f2f5</textcolor>
                                <focusedcolor>ffff8800</focusedcolor>
                                <texturefocus>-</texturefocus>
                                <texturenofocus>-</texturenofocus>
                                <onup>9004</onup>
                                <ondown>9004</ondown>
                                <onclick>ActivateWindow(Settings)</onclick>
                        </control>

                        <!-- mittiger Statusblock -->
                        <control type="group">
                                <left>720</left>
                                <top>20</top>
                                <width>430</width>
                                <height>82</height>

                                <control type="image">
                                        <left>0</left>
                                        <top>11</top>
                                        <width>54</width>
                                        <height>54</height>
                                        <aspectratio>keep</aspectratio>
                                        <texture>$INFO[Weather.ConditionsIcon]</texture>
                                </control>

                                <control type="label">
                                        <left>68</left>
                                        <top>0</top>
                                        <width>120</width>
                                        <height>82</height>
                                        <aligny>center</aligny>
                                        <font>font45</font>
                                        <textcolor>fff0f2f5</textcolor>
                                        <label>[B]$INFO[Weather.Temperature][/B]</label>
                                </control>

                                <control type="image">
                                        <left>195</left>
                                        <top>16</top>
                                        <width>2</width>
                                        <height>48</height>
                                        <texture colordiffuse="55ffffff">colors/white.png</texture>
                                </control>

                                <control type="label">
                                        <left>220</left>
                                        <top>0</top>
                                        <width>170</width>
                                        <height>82</height>
                                        <aligny>center</aligny>
                                        <font>font45</font>
                                        <textcolor>fff0f2f5</textcolor>
                                        <label>[B]$INFO[System.Time(hh:mm)][/B]</label>
                                </control>
                        </control>

                        <!-- Hauptmenü rechts -->
                        <control type="button" id="9004">
                                <right>15</right>
                                <top>20</top>
                                <width>500</width>
                                <height>82</height>
                                <font>font45</font>
                                <label>[B]Hauptmenü[/B]</label>
                                <align>right</align>
                                <textoffsetx>0</textoffsetx>
                                <aligny>center</aligny>
                                <textcolor>fff0f2f5</textcolor>
                                <focusedcolor>ffff8800</focusedcolor>
                                <texturefocus>-</texturefocus>
                                <texturenofocus>-</texturenofocus>
                                <onup>9002</onup>
                                <ondown>9002</ondown>
                                <onclick>ActivateWindow(Home)</onclick>
                        </control>

                </control>
	</controls>
</window>
