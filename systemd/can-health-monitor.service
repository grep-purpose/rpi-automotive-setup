[Unit]
Description=Passive Raspberry Pi Automotive CAN Health Monitor
After=can_handler.service can_keyboard_control.service

[Service]
Type=simple
User=root
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/pi/rpi-automotive-setup/scripts/can_health_monitor.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
