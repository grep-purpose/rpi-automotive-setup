<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">9000</defaultcontrol>
    <views>9000</views>

    <controls>

        <!-- =========================================================
             AUDI HOME v3
             Modern MMI / RNS-E inspired interface
             ========================================================= -->


        <!-- BACKGROUND -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="ff05070a">colors/black.png</texture>
        </control>


        <!-- =========================================================
             HEADER
             ========================================================= -->

        <control type="group">
            <left>30</left>
            <right>30</right>
            <top>18</top>
            <height>105</height>

            <!-- linke MMI-Linie: gleiche Position wie in den Apps -->
            <control type="image">
                <left>0</left>
                <top>82</top>
                <width>525</width>
                <height>3</height>
                <texture colordiffuse="99ffffff">colors/white.png</texture>
            </control>

            <!-- Haupttitel -->
            <control type="label">
                <left>540</left>
                <top>0</top>
                <width>780</width>
                <height>100</height>
                <align>center</align>
                <aligny>center</aligny>
                <font>font60</font>
                <textcolor>ffd90429</textcolor>
                <label>[B]Hauptmenü[/B]</label>
            </control>

            <!-- rechte MMI-Linie: gleiche Position wie in den Apps -->
            <control type="image">
                <right>0</right>
                <top>82</top>
                <width>525</width>
                <height>3</height>
                <texture colordiffuse="99ffffff">colors/white.png</texture>
            </control>

        </control>


        <!-- =========================================================
             HAUPTKARUSSELL

             240 px linker Rand
             1440 px Nutzbreite
             480 px je Element
             Fokusposition 1 = Bildschirmmitte bei X=960
             ========================================================= -->

        <control type="wraplist" id="9000">

            <left>80</left>
            <top>165</top>
            <top condition="Player.HasMedia">155</top>

            <width>1760</width>

            <height>700</height>
            <height condition="Player.HasMedia">575</height>

            <orientation>horizontal</orientation>

            <onleft>Control.Move(9000,-1)</onleft>
            <onright>Control.Move(9000,1)</onright>

            <!-- vorerst weiterhin kompatibel mit bisheriger Bedienung -->
            <onup>Control.Move(9000,-1)</onup>
            <ondown>Control.Move(9000,1)</ondown>

            <focusposition>2</focusposition>
            <movement>0</movement>

            <scrolltime tween="cubic" ease="out">220</scrolltime>


            <!-- =============================================
                 NICHT AUSGEWÄHLTE APP
                 kleiner / weiter hinten
                 ============================================= -->

            <itemlayout width="352" height="560">

                <control type="group">
                    <left>6</left>
                    <top>62</top>

                    <!-- dezente Tiefenfläche -->
                    <control type="image">
                        <left>20</left>
                        <top>35</top>
                        <width>300</width>
                        <height>300</height>
                        <texture colordiffuse="1019222b">colors/white.png</texture>
                    </control>

                    <!-- Icon -->
                    <control type="image">
                        <left>55</left>
                        <top>55</top>
                        <width>230</width>
                        <height>230</height>
                        <aspectratio>keep</aspectratio>
                        <texture colordiffuse="bfc8cfd8">$INFO[ListItem.Icon]</texture>
                    </control>

                    <!-- Name -->
                    <control type="label">
                        <left>0</left>
                        <top>315</top>
                        <width>340</width>
                        <height>78</height>
                        <align>center</align>
                        <aligny>center</aligny>
                        <font>font45</font>
                        <textcolor>e0e8ebef</textcolor>
                        <label>[B]$INFO[ListItem.Label][/B]</label>
                    </control>
                </control>

            </itemlayout>


            <!-- =============================================
                 AUSGEWÄHLTE APP
                 moderne MMI-Karte mit Tiefenwirkung
                 ============================================= -->

            <focusedlayout width="352" height="560">

                <control type="group">
                    <left>-34</left>
                    <top>0</top>

                    <!-- Schatten -->
                    <control type="image">
                        <left>12</left>
                        <top>22</top>
                        <width>410</width>
                        <height>505</height>
                        <texture colordiffuse="aa000000">colors/black.png</texture>
                    </control>

                    <!-- Tiefenlayer -->
                    <control type="image">
                        <left>4</left>
                        <top>12</top>
                        <width>410</width>
                        <height>500</height>
                        <texture colordiffuse="55182028">colors/white.png</texture>
                    </control>

                    <!-- Hauptkarte -->
                    <control type="image">
                        <left>12</left>
                        <top>20</top>
                        <width>394</width>
                        <height>480</height>
                        <texture colordiffuse="f0121820">colors/white.png</texture>
                    </control>

                    <!-- Lichtkante -->
                    <control type="image">
                        <left>14</left>
                        <top>21</top>
                        <width>390</width>
                        <height>4</height>
                        <texture colordiffuse="66ffffff">colors/white.png</texture>
                    </control>

                    <!-- innere Fläche -->
                    <control type="image">
                        <left>32</left>
                        <top>42</top>
                        <width>354</width>
                        <height>300</height>
                        <texture colordiffuse="1e26323f">colors/white.png</texture>
                    </control>

                    <!-- Icon -->
                    <control type="image">
                        <left>62</left>
                        <top>52</top>
                        <width>295</width>
                        <height>295</height>
                        <aspectratio>keep</aspectratio>
                        <texture colordiffuse="ffffffff">$INFO[ListItem.Icon]</texture>
                    </control>

                    <!-- Name -->
                    <control type="label">
                        <left>10</left>
                        <top>365</top>
                        <width>395</width>
                        <height>85</height>
                        <align>center</align>
                        <aligny>center</aligny>
                        <font>font60</font>
                        <textcolor>ffffffff</textcolor>
                        <label>[B]$INFO[ListItem.Label][/B]</label>
                    </control>

                    <!-- Fokuslinie -->
                    <control type="image">
                        <left>92</left>
                        <top>475</top>
                        <width>235</width>
                        <height>7</height>
                        <texture colordiffuse="ffff6b00">colors/white.png</texture>
                    </control>

                </control>

            </focusedlayout>


            <!-- =====================================================
                 APPS
                 Funktionspfade bewusst aus funktionierendem Stand
                 übernommen
                 ===================================================== -->

            <content>

                <item>
                    <label>Fernsehen</label>
                    <icon>home/tv.png</icon>
                    <onclick>ActivateWindow(TVChannels)</onclick>
                </item>

                <item>
                    <label>YouTube</label>
                    <icon>home/youtube.png</icon>
                    <onclick>ActivateWindow(Videos,plugin://plugin.video.youtube/special/recommendations?category_label=Recommendations,return)</onclick>
                </item>

                <item>
                    <label>Twitch</label>
                    <icon>home/twitch.png</icon>
                    <onclick>ActivateWindow(10025,&quot;plugin://plugin.video.twitch/?content=live&amp;mode=followed&quot;,return)</onclick>
                </item>

                <item>
                    <label>Radio</label>
                    <icon>home/radio.png</icon>
                    <onclick>ActivateWindow(10502,&quot;plugin://plugin.audio.radiode/?data=%7b%22name%22%3a%20%22Local%20stations%22%7d&amp;mode=get_local_stations&quot;,return)</onclick>
                </item>

                <item>
                    <label>Android Auto</label>
                    <icon>home/android_auto.png</icon>
                    <onclick>RunScript(/home/pi/.kodi/userdata/scripts/android_auto_toggle.py)</onclick>
                </item>

                <item>
                    <label>Wetter</label>
                    <icon>home/weather.png</icon>
                    <onclick>ActivateWindow(Weather)</onclick>
                </item>

                <item>
                    <label>Spiele</label>
                    <icon>home/games.png</icon>
                    <onclick>RunScript(script.audi.games)</onclick>
                </item>

            </content>

        </control>


        <!-- =========================================================
             NOW PLAYING
             große Automotive-Informationszone
             ========================================================= -->

        <control type="group">

            <left>30</left>
            <right>30</right>
            <bottom>175</bottom>
            <height>250</height>

            <visible>Player.HasMedia</visible>

            <!-- Schatten -->
            <control type="image">
                <left>5</left>
                <top>7</top>
                <width>100%</width>
                <height>230</height>
                <texture colordiffuse="99000000">colors/black.png</texture>
            </control>

            <!-- Hauptfläche -->
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>100%</width>
                <height>225</height>
                <texture colordiffuse="f20b1016">colors/white.png</texture>
            </control>

            <!-- obere Lichtkante -->
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>100%</width>
                <height>4</height>
                <texture colordiffuse="668d99ae">colors/white.png</texture>
            </control>

            <!-- Audi-Orange links -->
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>8</width>
                <height>225</height>
                <texture colordiffuse="ffff6b00">colors/white.png</texture>
            </control>

            <!-- Cover / Senderlogo -->
            <control type="image">
                <left>22</left>
                <top>20</top>
                <width>195</width>
                <height>195</height>
                <aspectratio>keep</aspectratio>
                <texture>$INFO[Player.Art(thumb)]</texture>
            </control>

            <!-- METADATEN MITTE -->

            <!-- Artist -->
            <control type="label">
                <left>255</left>
                <top>46</top>
                <width>980</width>
                <height>70</height>
                <font>font45</font>
                <textcolor>ffffffff</textcolor>
                <visible>!String.IsEmpty(MusicPlayer.Artist)</visible>
                <label>[B]$INFO[MusicPlayer.Artist][/B]</label>
            </control>

            <!-- Sender-Fallback -->
            <control type="label">
                <left>255</left>
                <top>46</top>
                <width>980</width>
                <height>70</height>
                <font>font45</font>
                <textcolor>ffffffff</textcolor>
                <visible>String.IsEmpty(MusicPlayer.Artist)</visible>
                <label>[B]$INFO[MusicPlayer.ChannelName][/B]</label>
            </control>

            <!-- Titel -->
            <control type="label">
                <left>255</left>
                <top>122</top>
                <width>980</width>
                <height>70</height>
                <font>font45</font>
                <textcolor>ffff8a32</textcolor>
                <visible>!String.IsEmpty(MusicPlayer.Title)</visible>
                <label>[B]$INFO[MusicPlayer.Title][/B]</label>
            </control>

            <!-- Titel-Fallback -->
            <control type="label">
                <left>255</left>
                <top>122</top>
                <width>980</width>
                <height>70</height>
                <font>font45</font>
                <textcolor>ffff8a32</textcolor>
                <visible>String.IsEmpty(MusicPlayer.Title)</visible>
                <label>[B]$INFO[Player.Title][/B]</label>
            </control>


            <!-- RECHTE STATUSZONE -->

            <!-- vertikale Trennung -->
            <control type="image">
                <left>1325</left>
                <top>24</top>
                <width>3</width>
                <height>178</height>
                <texture colordiffuse="668d99ae">colors/white.png</texture>
            </control>

            <!-- =====================================================
                 RECHTE STATUSZONE
                 Radio: Sender / Provider / Live
                 Andere Medien: bisherige Quellenanzeige
                 ===================================================== -->

            <!-- Radio: Überschrift -->
            <control type="label">
                <left>1365</left>
                <top>30</top>
                <width>400</width>
                <height>45</height>
                <font>font30_title</font>
                <textcolor>ff9da6b2</textcolor>
                <visible>!String.IsEmpty(Window(Home).Property(RNSE.RadioStation))</visible>
                <label>SENDER</label>
            </control>

            <!-- Andere Medien: Überschrift -->
            <control type="label">
                <left>1365</left>
                <top>30</top>
                <width>400</width>
                <height>45</height>
                <font>font30_title</font>
                <textcolor>ff9da6b2</textcolor>
                <visible>String.IsEmpty(Window(Home).Property(RNSE.RadioStation))</visible>
                <label>QUELLE</label>
            </control>

            <!-- Radio: echter Sendername aus Metadata Service -->
            <control type="label">
                <left>1365</left>
                <top>72</top>
                <width>430</width>
                <height>65</height>
                <font>font45</font>
                <textcolor>ffffffff</textcolor>
                <visible>!String.IsEmpty(Window(Home).Property(RNSE.RadioStation))</visible>
                <label>[B]$INFO[Window(Home).Property(RNSE.RadioStation)][/B]</label>
            </control>

            <!-- Radio: Provider -->
            <control type="label">
                <left>1365</left>
                <top>145</top>
                <width>190</width>
                <height>50</height>
                <font>font30_title</font>
                <textcolor>ffd5dae0</textcolor>
                <visible>!String.IsEmpty(Window(Home).Property(RNSE.RadioStation))</visible>
                <label>RADIO.DE</label>
            </control>

            <!-- Radio: Trenner -->
            <control type="label">
                <left>1535</left>
                <top>145</top>
                <width>35</width>
                <height>50</height>
                <font>font30_title</font>
                <textcolor>ff7f8790</textcolor>
                <visible>!String.IsEmpty(Window(Home).Property(RNSE.RadioStation))</visible>
                <label>·</label>
            </control>

            <!-- Radio: Live-Status -->
            <control type="label">
                <left>1570</left>
                <top>145</top>
                <width>150</width>
                <height>50</height>
                <font>font30_title</font>
                <textcolor>ffff8a32</textcolor>
                <visible>!String.IsEmpty(Window(Home).Property(RNSE.RadioStation))</visible>
                <label>[B]LIVE[/B]</label>
            </control>

            <!-- Andere Medien: echter ChannelName, falls vorhanden -->
            <control type="label">
                <left>1365</left>
                <top>72</top>
                <width>430</width>
                <height>65</height>
                <font>font45</font>
                <textcolor>ffffffff</textcolor>
                <visible>String.IsEmpty(Window(Home).Property(RNSE.RadioStation)) + !String.IsEmpty(MusicPlayer.ChannelName)</visible>
                <label>[B]$INFO[MusicPlayer.ChannelName][/B]</label>
            </control>

            <!-- Radio.de Fallback, falls Metadata Service einmal nichts liefert -->
            <control type="label">
                <left>1365</left>
                <top>72</top>
                <width>430</width>
                <height>65</height>
                <font>font45</font>
                <textcolor>ffffffff</textcolor>
                <visible>String.IsEmpty(Window(Home).Property(RNSE.RadioStation)) + String.IsEmpty(MusicPlayer.ChannelName) + String.Contains(Player.FilenameAndPath,plugin.audio.radiode)</visible>
                <label>[B]RADIO.DE[/B]</label>
            </control>

            <!-- Generischer Medien-Fallback -->
            <control type="label">
                <left>1365</left>
                <top>72</top>
                <width>430</width>
                <height>65</height>
                <font>font45</font>
                <textcolor>ffffffff</textcolor>
                <visible>String.IsEmpty(Window(Home).Property(RNSE.RadioStation)) + String.IsEmpty(MusicPlayer.ChannelName) + !String.Contains(Player.FilenameAndPath,plugin.audio.radiode)</visible>
                <label>[B]MEDIA[/B]</label>
            </control>

            <!-- Andere Medien: LIVE bei Streams ohne Dauer -->
            <control type="label">
                <left>1365</left>
                <top>145</top>
                <width>430</width>
                <height>50</height>
                <font>font36_title</font>
                <textcolor>ffff8a32</textcolor>
                <visible>String.IsEmpty(Window(Home).Property(RNSE.RadioStation)) + String.IsEmpty(Player.Duration)</visible>
                <label>[B]LIVE[/B]</label>
            </control>

            <!-- Andere Medien: Laufzeit -->
            <control type="label">
                <left>1365</left>
                <top>145</top>
                <width>430</width>
                <height>50</height>
                <font>font30_title</font>
                <textcolor>ffd5dae0</textcolor>
                <visible>String.IsEmpty(Window(Home).Property(RNSE.RadioStation)) + !String.IsEmpty(Player.Duration)</visible>
                <label>$INFO[Player.Time]  /  $INFO[Player.Duration]</label>
            </control>

            <!-- untere Akzentlinie -->
            <control type="image">
                <left>255</left>
                <top>205</top>
                <width>930</width>
                <height>3</height>
                <texture colordiffuse="338d99ae">colors/white.png</texture>
            </control>

        </control>


        <!-- =========================================================
             FOOTER
             ========================================================= -->

        <control type="group">

            <left>30</left>
            <right>30</right>
            <bottom>18</bottom>
            <height>124</height>


            <!-- obere MMI Linie -->
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>100%</width>
                <height>5</height>
                <texture colordiffuse="aaffffff">colors/white.png</texture>
            </control>


            <!-- Einstellungen links: sichtbares Label -->
            <control type="label">
                <left>15</left>
                <top>20</top>
                <width>500</width>
                <height>82</height>
                <aligny>center</aligny>
                <font>font45</font>
                <textcolor>fff0f2f5</textcolor>
                <label>[B]Einstellungen[/B]</label>
            </control>

            <!-- Unsichtbares Fokus-Control -->
            <control type="button" id="9100">
                <left>15</left>
                <top>20</top>
                <width>500</width>
                <height>82</height>

                <label></label>
                <texturefocus>-</texturefocus>
                <texturenofocus>-</texturenofocus>

                <onup>9100</onup>
                <ondown>9100</ondown>
                <onleft>9100</onleft>
                <onright>9100</onright>

                <onclick>ActivateWindow(Settings)</onclick>
            </control>

            <!-- Fokuslinie -->
            <control type="image">
                <left>15</left>
                <top>100</top>
                <width>250</width>
                <height>4</height>
                <texture colordiffuse="ffff8800">colors/white.png</texture>
                <visible>Control.HasFocus(9100)</visible>
            </control>


            <!-- EXAKT ZENTRIERTER Statusblock
                 520px breit, Bildschirmmitte 960:
                 960 - 260 - 30 Gruppenoffset = 670
            -->

            <control type="group">

                <left>720</left>
                <top>20</top>
                <width>430</width>
                <height>82</height>


                <!-- Wettericon -->
                <control type="image">
                    <left>0</left>
                    <top>11</top>
                    <width>54</width>
                    <height>54</height>
                    <aspectratio>keep</aspectratio>
                    <texture>$INFO[Weather.ConditionsIcon]</texture>
                </control>


                <!-- Temperatur -->
                <control type="label">
                    <left>68</left>
                    <top>0</top>
                    <width>120</width>
                    <height>82</height>
                    <aligny>center</aligny>
                    <font>font45</font>
                    <textcolor>fff0f2f5</textcolor>
                    <label>[B]$INFO[Weather.Temperature][/B]</label>
                </control>

                <!-- kleine Trennung -->
                <control type="image">
                    <left>195</left>
                    <top>16</top>
                    <width>2</width>
                    <height>48</height>
                    <texture colordiffuse="55ffffff">colors/white.png</texture>
                </control>

                <!-- Uhrzeit -->
                <control type="label">
                    <left>220</left>
                    <top>0</top>
                    <width>170</width>
                    <height>82</height>
                    <aligny>center</aligny>
                    <font>font45</font>
                    <textcolor>fff0f2f5</textcolor>
                    <label>[B]$INFO[System.Time(hh:mm)][/B]</label>
                </control>

            </control>

        </control>

    </controls>
</window>
