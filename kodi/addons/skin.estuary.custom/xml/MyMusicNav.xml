<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<backgroundcolor>background</backgroundcolor>
	<views>50,51</views>
	<menucontrol>9000</menucontrol>
	<controls>
		<!-- 1. Background -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>100%</width>
			<height>100%</height>
			<texture>colors/black.png</texture>
		</control>

		<!-- ========================================================================= -->
		<!-- 2A. SENDERLISTE FULLSCREEN (ID 50) - Aktiv wenn KEINE Musik laeuft        -->
		<!-- Reicht von top=105 bis bottom=135 direkt an die Statusleiste              -->
		<!-- ========================================================================= -->
		<control type="fixedlist" id="50">
			<left>40</left>
			<top>105</top>
			<bottom>135</bottom>
			<width>1840</width>
			<visible>!Player.HasMedia</visible>
			<onup>9001</onup>
			<ondown>9002</ondown>
			<onleft>50</onleft>
			<onright>50</onright>
			<viewtype label="Kacheln">list</viewtype>
			<orientation>vertical</orientation>
			<focusposition>0</focusposition>
			<movement>1</movement>
			<scrolltime tween="sine" easing="out">130</scrolltime>
			<hideparentitems>true</hideparentitems>

			<itemlayout width="1840" height="420">
				<control type="image">
					<left>15</left>
					<top>20</top>
					<width>380</width>
					<height>380</height>
					<texture background="true" fallback="DefaultAudio.png">$INFO[ListItem.Art(thumb)]</texture>
					<aspectratio align="center" aligny="center">keep</aspectratio>
				</control>
				<control type="label">
					<left>430</left>
					<top>25</top>
					<width>1380</width>
					<height>85</height>
					<font>font45</font>
					<wrapmultiline>true</wrapmultiline>
					<label>[B]$INFO[ListItem.Label][/B]</label>
				</control>
				<control type="textbox">
					<left>430</left>
					<top>125</top>
					<width>1380</width>
					<height>250</height>
					<font>font24</font>
					<textcolor>77ffffff</textcolor>
					<label>$INFO[ListItem.Genre,[B],[/B]  •  ]$INFO[ListItem.PlotOutline]$INFO[ListItem.Plot]$INFO[ListItem.Comment]</label>
				</control>
			</itemlayout>

			<focusedlayout width="1840" height="420">
				<control type="image">
					<left>8</left>
					<top>13</top>
					<width>394</width>
					<height>394</height>
					<texture border="6">colors/white.png</texture>
					<colordiffuse>ffff8800</colordiffuse>
				</control>
				<control type="image">
					<left>15</left>
					<top>20</top>
					<width>380</width>
					<height>380</height>
					<texture background="true" fallback="DefaultAudio.png">$INFO[ListItem.Art(thumb)]</texture>
					<aspectratio align="center" aligny="center">keep</aspectratio>
				</control>
				<control type="label">
					<left>430</left>
					<top>25</top>
					<width>1380</width>
					<height>85</height>
					<font>font45</font>
					<scroll>true</scroll>
					<wrapmultiline>true</wrapmultiline>
					<label>[B]$INFO[ListItem.Label][/B]</label>
				</control>
				<control type="textbox">
					<left>430</left>
					<top>125</top>
					<width>1380</width>
					<height>250</height>
					<font>font24</font>
					<textcolor>white</textcolor>
					<label>$INFO[ListItem.Genre,[B],[/B]  •  ]$INFO[ListItem.PlotOutline]$INFO[ListItem.Plot]$INFO[ListItem.Comment]</label>
				</control>
			</focusedlayout>
		</control>

		<!-- ========================================================================= -->
		<!-- 2B. SENDERLISTE KOMPAKT (ID 51) - Aktiv sobald MUSIK LÄUFT                -->
		<!-- Reicht von top=105 bis bottom=325 buendig an die Now-Playing-Bar          -->
		<!-- ========================================================================= -->
		<control type="fixedlist" id="51">
			<left>40</left>
			<top>105</top>
			<bottom>325</bottom>
			<width>1840</width>
			<visible>Player.HasMedia</visible>
			<onup>9001</onup>
			<ondown>9002</ondown>
			<onleft>51</onleft>
			<onright>51</onright>
			<viewtype label="Kacheln">list</viewtype>
			<orientation>vertical</orientation>
			<focusposition>0</focusposition>
			<movement>1</movement>
			<scrolltime tween="sine" easing="out">130</scrolltime>
			<hideparentitems>true</hideparentitems>

			<itemlayout width="1840" height="420">
				<control type="image">
					<left>15</left>
					<top>20</top>
					<width>380</width>
					<height>380</height>
					<texture background="true" fallback="DefaultAudio.png">$INFO[ListItem.Art(thumb)]</texture>
					<aspectratio align="center" aligny="center">keep</aspectratio>
				</control>
				<control type="label">
					<left>430</left>
					<top>25</top>
					<width>1380</width>
					<height>85</height>
					<font>font45</font>
					<wrapmultiline>true</wrapmultiline>
					<label>[B]$INFO[ListItem.Label][/B]</label>
				</control>
				<control type="textbox">
					<left>430</left>
					<top>125</top>
					<width>1380</width>
					<height>250</height>
					<font>font24</font>
					<textcolor>77ffffff</textcolor>
					<label>$INFO[ListItem.Genre,[B],[/B]  •  ]$INFO[ListItem.PlotOutline]$INFO[ListItem.Plot]$INFO[ListItem.Comment]</label>
				</control>
			</itemlayout>

			<focusedlayout width="1840" height="420">
				<control type="image">
					<left>8</left>
					<top>13</top>
					<width>394</width>
					<height>394</height>
					<texture border="6">colors/white.png</texture>
					<colordiffuse>ffff8800</colordiffuse>
				</control>
				<control type="image">
					<left>15</left>
					<top>20</top>
					<width>380</width>
					<height>380</height>
					<texture background="true" fallback="DefaultAudio.png">$INFO[ListItem.Art(thumb)]</texture>
					<aspectratio align="center" aligny="center">keep</aspectratio>
				</control>
				<control type="label">
					<left>430</left>
					<top>25</top>
					<width>1380</width>
					<height>85</height>
					<font>font45</font>
					<scroll>true</scroll>
					<wrapmultiline>true</wrapmultiline>
					<label>[B]$INFO[ListItem.Label][/B]</label>
				</control>
				<control type="textbox">
					<left>430</left>
					<top>125</top>
					<width>1380</width>
					<height>250</height>
					<font>font24</font>
					<textcolor>white</textcolor>
					<label>$INFO[ListItem.Genre,[B],[/B]  •  ]$INFO[ListItem.PlotOutline]$INFO[ListItem.Plot]$INFO[ListItem.Comment]</label>
				</control>
			</focusedlayout>
		</control>

		<!-- 3. Großer OEM Audi Top-Header (Fest auf top=15 bis top=100) -->
		<control type="group">
			<top>15</top>
			<left>40</left>
			<right>40</right>
			<height>85</height>

			<!-- Oben Links: Suche (ID 9001) -->
			<control type="button" id="9001">
				<left>10</left>
				<top>5</top>
				<width>260</width>
				<height>65</height>
				<font>font45</font>
				<label>[B]Suche[/B]</label>
				<align>left</align>
				<textoffsetx>10</textoffsetx>
				<textcolor>fff0f2f5</textcolor>
				<focusedcolor>ffff8800</focusedcolor>
				<texturefocus border="0">-</texturefocus>
				<texturenofocus border="0">-</texturenofocus>
				<onup>9003</onup>
				<ondown condition="!Player.HasMedia">50</ondown>
				<ondown condition="Player.HasMedia">51</ondown>
				<onclick>Skin.SetString(SearchQuery)</onclick>
			</control>

			<!-- Trennlinie Links (top 75) -->
			<control type="image">
				<left>10</left>
				<top>75</top>
				<width>300</width>
				<height>4</height>
				<texture colordiffuse="88ffffff">colors/white.png</texture>
			</control>

			<!-- Zentrierter Audi MMI Titel (Audi-Rot ffd90429) -->
			<control type="label">
				<left>0</left>
				<right>0</right>
				<top>10</top>
				<height>75</height>
				<align>center</align>
				<font>font45</font>
				<textcolor>ffd90429</textcolor>
				<label>[B]$INFO[Container.FolderName][/B]</label>
			</control>

			<!-- Oben Rechts: Neu laden (ID 9003 - Oberer Anschlag) -->
			<control type="button" id="9003">
				<right>10</right>
				<top>5</top>
				<width>280</width>
				<height>65</height>
				<font>font45</font>
				<label>[B]Neu laden[/B]</label>
				<align>right</align>
				<textoffsetx>10</textoffsetx>
				<textcolor>fff0f2f5</textcolor>
				<focusedcolor>ffff8800</focusedcolor>
				<texturefocus border="0">-</texturefocus>
				<texturenofocus border="0">-</texturenofocus>
				<onup>noop</onup>
				<ondown>9001</ondown>
				<onclick>Container.Refresh</onclick>
			</control>

			<!-- Trennlinie Rechts (top 75) -->
			<control type="image">
				<right>10</right>
				<top>75</top>
				<width>300</width>
				<height>4</height>
				<texture colordiffuse="88ffffff">colors/white.png</texture>
			</control>
		</control>

		<!-- 4. MASSIVE RNS-E LIVE NOW-PLAYING BAR (bottom=135 bis bottom=325, height=190) -->
		<control type="group">
			<left>0</left>
			<right>0</right>
			<bottom>135</bottom>
			<height>190</height>
			<visible>Player.HasMedia</visible>

			<!-- 100% Blickdichter schwarzer Hintergrund -->
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>100%</width>
				<height>100%</height>
				<texture>colors/black.png</texture>
			</control>

			<!-- Feine obere Trennlinie zur Senderliste -->
			<control type="image">
				<left>40</left>
				<right>40</right>
				<top>0</top>
				<height>3</height>
				<texture colordiffuse="44ffffff">colors/white.png</texture>
			</control>

			<!-- Großes Senderlogo links (165x165) -->
			<control type="image">
				<left>50</left>
				<top>12</top>
				<width>165</width>
				<height>165</height>
				<aspectratio align="center" aligny="center">keep</aspectratio>
				<texture fallback="DefaultAudio.png">$INFO[Player.Art(thumb)]</texture>
			</control>

			<!-- Zeile 1: Sendername / Interpret (font36_title, Reinweiss) -->
			<control type="label">
				<left>240</left>
				<top>10</top>
				<right>60</right>
				<height>48</height>
				<font>font36_title</font>
				<textcolor>ffffffff</textcolor>
				<scroll>true</scroll>
				<label>[B]$INFO[MusicPlayer.Artist]$INFO[MusicPlayer.ChannelName, • ][/B]</label>
			</control>

			<!-- Zeile 2: MASSIVER TRACK-TITEL (font45, FETT, AUDI-ROT ffd90429, SCROLLEND) -->
			<control type="label">
				<left>240</left>
				<top>60</top>
				<right>60</right>
				<height>68</height>
				<font>font45</font>
				<textcolor>ffd90429</textcolor>
				<scroll>true</scroll>
				<visible>!String.IsEmpty(MusicPlayer.Title)</visible>
				<label>[B]$INFO[MusicPlayer.Title][/B]</label>
			</control>
			<control type="label">
				<left>240</left>
				<top>60</top>
				<right>60</right>
				<height>68</height>
				<font>font45</font>
				<textcolor>ffd90429</textcolor>
				<scroll>true</scroll>
				<visible>String.IsEmpty(MusicPlayer.Title)</visible>
				<label>[B]$INFO[Player.Title][/B]</label>
			</control>

			<!-- Zeile 3: Technische Details (Codec, kbps, Hz, Stereo/Mono) -->
			<control type="label">
				<left>240</left>
				<top>135</top>
				<right>60</right>
				<height>40</height>
				<font>font24</font>
				<textcolor>99ffffff</textcolor>
				<label>$INFO[MusicPlayer.Codec,[B],[/B]  •  ]$INFO[MusicPlayer.Bitrate,, kbps  •  ]$INFO[MusicPlayer.SampleRate,, Hz  •  ]$INFO[MusicPlayer.Channels,, Kanäle]</label>
			</control>
		</control>

		<!-- 5. RNS-E Status-Footer (100% blickdicht schwarz, bottom=0 bis bottom=135) -->
		<control type="group">
			<bottom>0</bottom>
			<left>0</left>
			<right>0</right>
			<height>135</height>

			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>100%</width>
				<height>100%</height>
				<texture>colors/black.png</texture>
			</control>

			<!-- Weiße MMI-Trennlinie oben auf der Leiste -->
			<control type="image">
				<left>40</left>
				<right>40</right>
				<top>0</top>
				<height>6</height>
				<texture colordiffuse="99ffffff">colors/white.png</texture>
			</control>

			<!-- Unten Links: Einstellungen (ID 9002) -->
			<control type="button" id="9002">
				<left>60</left>
				<top>30</top>
				<width>380</width>
				<height>75</height>
				<font>font45</font>
				<label>[B]Einstellungen[/B]</label>
				<align>left</align>
				<textcolor>fff0f2f5</textcolor>
				<focusedcolor>ffff8800</focusedcolor>
				<texturefocus border="0">-</texturefocus>
				<texturenofocus border="0">-</texturenofocus>
				<onup condition="!Player.HasMedia">50</onup>
				<onup condition="Player.HasMedia">51</onup>
				<ondown>9004</ondown>
				<onclick>ActivateWindow(Settings)</onclick>
			</control>

			<!-- Unten Mitte: Wetter & Digitaluhr -->
			<control type="group">
				<left>0</left>
				<right>0</right>
				<top>35</top>
				<height>75</height>

				<control type="group">
					<left>740</left>
					<top>0</top>
					<width>520</width>
					<height>75</height>

					<!-- Wetter Icon -->
					<control type="image">
						<left>0</left>
						<top>8</top>
						<width>65</width>
						<height>65</height>
						<aspectratio>keep</aspectratio>
						<texture>$INFO[Weather.ConditionsIcon]</texture>
					</control>

					<!-- Temperatur -->
					<control type="label">
						<left>80</left>
						<top>0</top>
						<width>170</width>
						<height>75</height>
						<font>font45</font>
						<textcolor>fff0f2f5</textcolor>
						<label>[B]$INFO[Weather.Temperature][/B]</label>
					</control>

					<!-- Digitaluhr -->
					<control type="label">
						<left>265</left>
						<top>0</top>
						<width>255</width>
						<height>75</height>
						<font>font45</font>
						<textcolor>fff0f2f5</textcolor>
						<label>[B]$INFO[System.Time(hh:mm)][/B]</label>
					</control>
				</control>
			</control>

			<!-- Unten Rechts: Home (ID 9004 - Unterer Anschlag) -->
			<control type="button" id="9004">
				<right>60</right>
				<top>30</top>
				<width>320</width>
				<height>75</height>
				<font>font45</font>
				<label>[B]Hauptmenü[/B]</label>
				<align>right</align>
				<textcolor>fff0f2f5</textcolor>
				<focusedcolor>ffff8800</focusedcolor>
				<texturefocus border="0">-</texturefocus>
				<texturenofocus border="0">-</texturenofocus>
				<onup>9002</onup>
				<ondown>noop</ondown>
				<onclick>ActivateWindow(Home)</onclick>
			</control>
		</control>
	</controls>
</window>
