<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
  <defaultcontrol always="true">9500</defaultcontrol>
  <controls>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture colordiffuse="99000000">colors/white.png</texture>
    </control>
    <control type="image">
      <left>210</left><top>130</top><width>1500</width><height>820</height>
      <texture border="45" colordiffuse="b3ffffff">music/transport_normal.png</texture>
    </control>
    <control type="image">
      <left>210</left><top>130</top><width>1500</width><height>820</height>
      <texture border="45" colordiffuse="e6ffffff">music/transport_normal.png</texture>
    </control>
    <control type="label">
      <left>310</left><top>190</top><width>1300</width><height>100</height>
      <font>font75</font><textcolor>ffffffff</textcolor>
      <align>center</align><aligny>center</aligny>
      <label>[B]Android Auto[/B]</label>
    </control>
    <control type="label">
      <left>310</left><top>290</top><width>1300</width><height>60</height>
      <font>font45</font><textcolor>ffcad3dd</textcolor>
      <align>center</align><aligny>center</aligny>
      <label>Darstellungsgröße · Aktuell: $INFO[Window(Home).Property(RNSE.AndroidAuto.DPI)] DPI</label>
    </control>
    <control type="list" id="9500">
      <left>350</left><top>365</top><width>1220</width><height>420</height>
      <orientation>vertical</orientation>
      <onup>9500</onup><ondown>9500</ondown>
      <onleft>Control.Move(9500,-1)</onleft>
      <onright>Control.Move(9500,1)</onright>
      <itemlayout width="1220" height="60">
        <control type="label">
          <left>55</left><top>0</top><width>650</width><height>60</height>
          <font>font55</font><textcolor>ffcad3dd</textcolor><aligny>center</aligny>
          <label>$INFO[ListItem.Label]</label>
        </control>
        <control type="label">
          <left>760</left><top>0</top><width>400</width><height>60</height>
          <font>font45</font><textcolor>ffcad3dd</textcolor>
          <align>right</align><aligny>center</aligny><label>$INFO[ListItem.Label2]</label>
        </control>
      </itemlayout>
      <focusedlayout width="1220" height="60">
        <control type="image">
          <left>0</left><top>1</top><width>1220</width><height>58</height>
          <texture border="15">music/transport_focus.png</texture>
        </control>
        <control type="label">
          <left>55</left><top>0</top><width>650</width><height>60</height>
          <font>font55</font><textcolor>ffffffff</textcolor><aligny>center</aligny>
          <label>[B]$INFO[ListItem.Label][/B]</label>
        </control>
        <control type="label">
          <left>760</left><top>0</top><width>400</width><height>60</height>
          <font>font45</font><textcolor>ffffffff</textcolor>
          <align>right</align><aligny>center</aligny><label>$INFO[ListItem.Label2]</label>
        </control>
      </focusedlayout>
    </control>
    <control type="label">
      <left>290</left><top>810</top><width>1340</width><height>60</height>
      <font>font45</font><textcolor>ffffffff</textcolor>
      <align>center</align><aligny>center</aligny>
      <label>Wird beim nächsten Start von Android Auto übernommen.</label>
    </control>
    <control type="label">
      <left>310</left><top>870</top><width>1300</width><height>55</height>
      <font>font45</font><textcolor>ffcad3dd</textcolor>
      <align>center</align><aligny>center</aligny>
      <label>Drücken: Übernehmen · Return: Abbrechen</label>
    </control>
  </controls>
</window>
