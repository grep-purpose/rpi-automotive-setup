<?xml version='1.0' encoding='UTF-8'?>
<window>
    <onload>RunScript(/home/pi/.kodi/userdata/scripts/music_status.py,monitor)</onload>
    <onload>RunScript(/home/pi/.kodi/userdata/scripts/phone_status.py)</onload>
    <defaultcontrol always="true">9000</defaultcontrol>
    <views>9000</views>
    <controls>
        <!-- =========================================================
             AUDI HOME v3
             Modern MMI / RNS-E inspired interface
             ========================================================= -->
        <!-- BACKGROUND -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="ff05070a">colors/black.png</texture>
        </control>
        <!-- =========================================================
             HEADER
             ========================================================= -->
        <control type="group">
            <left>30</left>
            <right>30</right>
            <top>18</top>
            <height>105</height>
            <!-- linke MMI-Linie: gleiche Position wie in den Apps -->
            <control type="image">
                <left>0</left>
                <top>82</top>
                <width>525</width>
                <height>3</height>
                <texture colordiffuse="99ffffff">colors/white.png</texture>
            </control>
            <!-- Haupttitel -->
            <control type="label">
                <left>540</left>
                <top>0</top>
                <width>780</width>
                <height>100</height>
                <align>center</align>
                <aligny>center</aligny>
                <font>font60</font>
                <textcolor>ffd90429</textcolor>
                <label>[B]Hauptmenü[/B]</label>
            </control>
            <!-- rechte MMI-Linie: gleiche Position wie in den Apps -->
            <control type="image">
                <right>0</right>
                <top>82</top>
                <width>525</width>
                <height>3</height>
                <texture colordiffuse="99ffffff">colors/white.png</texture>
            </control>
        </control>
        <!-- =========================================================
             HAUPTKARUSSELL

             240 px linker Rand
             1440 px Nutzbreite
             480 px je Element
             Fokusposition 1 = Bildschirmmitte bei X=960
             ========================================================= -->
        <control type="wraplist" id="9000">
            <left>30</left>
            <top>170</top>
            <top condition="Player.HasMedia | String.IsEqual(Window(Home).Property(RNSE.Music.Status),playing)">170</top>
            <width>1860</width>
            <height>495</height>
            <height condition="Player.HasMedia | String.IsEqual(Window(Home).Property(RNSE.Music.Status),playing)">495</height>
            <orientation>horizontal</orientation>
            <onleft>Control.Move(9000,-1)</onleft>
            <onright>Control.Move(9000,1)</onright>
            <!-- vorerst weiterhin kompatibel mit bisheriger Bedienung -->
            <onup>Control.Move(9000,-1)</onup>
            <ondown>Control.Move(9000,1)</ondown>
            <focusposition>2</focusposition>
            <movement>0</movement>
            <scrolltime tween="cubic" ease="out">220</scrolltime>
            <!-- =============================================
                 NICHT AUSGEWÄHLTE APP
                 kleiner / weiter hinten
                 ============================================= -->
            <itemlayout width="372" height="480">
        <control type="group">
            <left>15</left>
            <top>20</top>

            <control type="image">
                <left>0</left><top>0</top>
                <width>342</width><height>410</height>
                <texture>home/tile_normal.png</texture>
            </control>

            <control type="image">
                <left>52</left>
                <top>32</top>
                <width>238</width>
                <height>238</height>
                <aspectratio>keep</aspectratio>
                <texture>$INFO[ListItem.Icon]</texture>
                <visible>String.IsEqual(ListItem.Label,Radio)</visible>
            </control>
<control type="image">
                <left>61</left>
                <top>32</top>
                <width>219</width>
                <height>219</height>
                <aspectratio>keep</aspectratio>
                <texture>$INFO[ListItem.Icon]</texture>
                <visible>String.IsEqual(ListItem.Label,Android Auto)</visible>
            </control>
<control type="image">
                <left>52</left>
                <top>44</top>
                <width>238</width>
                <height>238</height>
                <aspectratio>keep</aspectratio>
                <texture>$INFO[ListItem.Icon]</texture>
                <visible>!String.IsEqual(ListItem.Label,Radio) + !String.IsEqual(ListItem.Label,Android Auto)</visible>
            </control>

            <control type="label">
                <left>8</left><top>292</top>
                <width>326</width><height>75</height>
                <align>center</align><aligny>center</aligny>
                <font>font55</font>
                <textcolor>ffffffff</textcolor>
                <label>[B]$INFO[ListItem.Label][/B]</label>
                <visible>!String.IsEqual(ListItem.Label,Android Auto)</visible>
            </control>

            <control type="label">
                <left>8</left><top>289</top>
                <width>326</width><height>46</height>
                <align>center</align><aligny>center</aligny>
                <font>font50</font>
                <textcolor>ffffffff</textcolor>
                <label>[B]Android[/B]</label>
                <visible>String.IsEqual(ListItem.Label,Android Auto)</visible>
            </control>

            <control type="label">
                <left>8</left><top>333</top>
                <width>326</width><height>46</height>
                <align>center</align><aligny>center</aligny>
                <font>font50</font>
                <textcolor>ffffffff</textcolor>
                <label>[B]Auto[/B]</label>
                <visible>String.IsEqual(ListItem.Label,Android Auto)</visible>
            </control>
        </control>
    </itemlayout>
            <!-- =============================================
                 AUSGEWÄHLTE APP
                 moderne MMI-Karte mit Tiefenwirkung
                 ============================================= -->
            <focusedlayout width="372" height="480">
        <control type="group">
            <left>15</left>
            <top>20</top>

            <control type="image">
                <left>0</left><top>0</top>
                <width>342</width><height>410</height>
