<?xml version='1.0' encoding='UTF-8'?>
<window>
    <defaultcontrol always="true">50</defaultcontrol>
    <onload>RunScript(/home/pi/.kodi/userdata/scripts/radio_player.py,open-if-active)</onload>
    <backgroundcolor>background</backgroundcolor>
    <views>50,51</views>
    <menucontrol>9000</menucontrol>
    <controls>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>100%</width>
            <height>100%</height>
            <texture>colors/black.png</texture>
        </control>
        <control type="fixedlist" id="50">
            <left>40</left>
            <top>135</top>
            <bottom>135</bottom>
            <width>1840</width>
            <visible>!Player.HasMedia</visible>
            <onup>50</onup>
            <ondown>50</ondown>
            <onleft>50</onleft>
            <onright>50</onright>
            <viewtype label="Kacheln">list</viewtype>
            <orientation>vertical</orientation>
            <focusposition>0</focusposition>
            <movement>1</movement>
            <scrolltime tween="sine" easing="out">130</scrolltime>
            <hideparentitems>true</hideparentitems>
            <itemlayout width="1840" height="420">
                <control type="image">
                    <left>15</left>
                    <top>20</top>
                    <width>380</width>
                    <height>380</height>
                    <texture background="true" fallback="DefaultAudio.png">$INFO[ListItem.Art(thumb)]</texture>
                    <aspectratio align="center" aligny="center">keep</aspectratio>
                </control>
                <control type="label">
                    <left>430</left>
                    <top>25</top>
                    <width>1380</width>
                    <height>85</height>
                    <font>font45</font>
                    <wrapmultiline>true</wrapmultiline>
                    <label>[B]$INFO[ListItem.Label][/B]</label>
                </control>
                <control type="textbox">
                    <left>430</left>
                    <top>125</top>
                    <width>1380</width>
                    <height>250</height>
                    <font>font24</font>
                    <textcolor>77ffffff</textcolor>
                    <label>$INFO[ListItem.Genre,[B],[/B]  •  ]$INFO[ListItem.PlotOutline]$INFO[ListItem.Plot]$INFO[ListItem.Comment]</label>
                </control>
            </itemlayout>
            <focusedlayout width="1840" height="420">
                <control type="image">
                    <left>8</left>
                    <top>13</top>
                    <width>394</width>
                    <height>394</height>
                    <texture border="6">colors/white.png</texture>
                    <colordiffuse>ffff8800</colordiffuse>
                </control>
                <control type="image">
                    <left>15</left>
