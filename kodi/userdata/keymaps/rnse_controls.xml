<?xml version="1.0" encoding="UTF-8"?>
<keymap>
  <global>
    <keyboard>
      <!-- Drehregler: Taste 1 = Up / Taste 2 = Down -->
      <one>Up</one>
      <two>Down</two>

      <!-- Dreh-Druck-Knopf = Auswählen -->
      <return>Select</return>

      <!-- Return-Taste = Zurück -->
      <escape>Back</escape>

      <!-- RNS-E SETUP kurz = globale Kodi/System-Einstellungen -->
      <m>ActivateWindow(Settings)</m>

      <!-- Steuerkreuz links: Up = PageUp / Down = PageDown -->
      <up>RunScript(/home/pi/.kodi/userdata/rnse_zone_nav.py,up)</up>
      <down>RunScript(/home/pi/.kodi/userdata/rnse_zone_nav.py,down)</down>

      <!-- Track-Tasten global = Links / Rechts -->
      <left>Left</left>
      <right>Right</right>
      <prev_track>Left</prev_track>
      <next_track>Right</next_track>

      <!-- RNS-E Track-Tasten: kurzer Druck -->
      <f7>RunScript(/home/pi/.kodi/userdata/rnse_media_router.py,previous)</f7>
      <f8>RunScript(/home/pi/.kodi/userdata/rnse_media_router.py,next)</f8>
    </keyboard>
  </global>

  <!-- EXKLUSIV IM HOMESCREEN -->
  <Home>
    <keyboard>

      <!--
        RNS-E linkes Steuerkreuz:
        oben  = Content / Karussell
        unten = Footer
      -->
      <up>RunScript(/home/pi/.kodi/userdata/rnse_zone_nav.py,up)</up>
      <down>RunScript(/home/pi/.kodi/userdata/rnse_zone_nav.py,down)</down>

      <!-- Track-Tasten vorerst wie bisher -->
      <left>PlayerControl(Previous)</left>
      <right>PlayerControl(Next)</right>
      <prev_track>PlayerControl(Previous)</prev_track>
      <next_track>PlayerControl(Next)</next_track>

    </keyboard>
  </Home>

  <!-- Vollbild Video -->
  <FullScreenVideo>
    <keyboard>
      <return>PlayPause</return>
      <escape>Back</escape>
      <up>Info</up>
      <down>ActivateWindow(PVROSDChannels)</down>
      <left>StepBack</left>
      <right>StepForward</right>
      <prev_track>StepBack</prev_track>
      <next_track>StepForward</next_track>
    </keyboard>
  </FullScreenVideo>

  <!-- Vollbild Live-TV -->
  <FullScreenLiveTV>
    <keyboard>
      <return>PlayPause</return>
      <escape>Back</escape>
      <up>Info</up>
      <down>ActivateWindow(PVROSDChannels)</down>
      <left>ChannelDown</left>
      <right>ChannelUp</right>
      <prev_track>ChannelDown</prev_track>
      <next_track>ChannelUp</next_track>

      <!-- RNS-E Track-Tasten: kurzer Druck = Senderwechsel -->
      <f7>ChannelDown</f7>
      <f8>ChannelUp</f8>
    </keyboard>
  </FullScreenLiveTV>
</keymap>
